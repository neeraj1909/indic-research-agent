APP_NAME=indic-research-agent
ENVIRONMENT=development
LOG_LEVEL=INFO

# LiteLLM proxy/OpenAI-compatible mode. Keep key/base blank in this template.
# For the LAN LiteLLM subscription proxy, chatgpt/* models require streaming.
LITELLM_MODEL=chatgpt/gpt-5.5
LITELLM_CUSTOM_LLM_PROVIDER=openai
LITELLM_API_KEY=
LITELLM_API_BASE=
LITELLM_TEMPERATURE=0.2
LITELLM_TIMEOUT_SECONDS=30
LITELLM_MAX_TOKENS=25600
LITELLM_STREAMING=true

# query-kit providers: acl, arxiv, pubmed, semantic-scholar, openreview, all.
QUERY_KIT_PROVIDERS=all
QUERY_KIT_TIMEOUT_SECONDS=30

APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/indic_research_agent
REDIS_URL=redis://localhost:6379/0

# Docker Compose exposes the app on localhost:8000.
COMPOSE_PROJECT_NAME=indic-research-agent
