APP_NAME=indic-research-agent
ENVIRONMENT=development
LOG_LEVEL=INFO

# LiteLLM proxy/OpenAI-compatible mode. Keep key/base blank in this template.
# For the LAN LiteLLM subscription proxy, chatgpt/* models require streaming.
LITELLM_MODEL=chatgpt/gpt-5.5
LITELLM_CUSTOM_LLM_PROVIDER=openai
LITELLM_API_KEY=
LITELLM_API_BASE=
LITELLM_TEMPERATURE=0.2
LITELLM_TIMEOUT_SECONDS=30
LITELLM_MAX_TOKENS=25600
LITELLM_STREAMING=true

# query-kit providers: acl, arxiv, arxiv-web, pubmed, semantic-scholar,
# semantic-scholar-web, openreview, all. Default uses the measured
# fast/partial-safe provider set plus safe public-web fallbacks for Indic OCR.
QUERY_KIT_PROVIDERS=semantic-scholar,semantic-scholar-web,pubmed,arxiv-web
QUERY_KIT_TIMEOUT_SECONDS=30
QUERY_CLI_USER_AGENT=indic-research-agent/0.1 (+https://github.com/neeraj1909/indic-research-agent)

# Phoenix/OpenTelemetry observability. The endpoint is the Phoenix app hostname;
# the app sends OTLP/HTTP traces to $PHOENIX_COLLECTOR_ENDPOINT/v1/traces.
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://10.20.30.1:16006
PHOENIX_PROJECT_NAME=indic-research-agent
PHOENIX_PROTOCOL=http/protobuf
PHOENIX_BATCH_SPANS=true
PHOENIX_AUTO_INSTRUMENT=true

APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/indic_research_agent
REDIS_URL=redis://localhost:6379/0

# Chainlit auth/history persistence for local development and e2e only.
# Replace the secret and credentials for any non-local deployment.
CHAINLIT_AUTH_SECRET=dev-only-chainlit-auth-secret-change-me
CHAINLIT_AUTH_ENABLED=true
CHAINLIT_AUTH_USERNAME=test
CHAINLIT_AUTH_PASSWORD=test1234
CHAINLIT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/indic_research_agent
CHAINLIT_DATABASE_SCHEMA=chainlit

# Docker Compose exposes the app on localhost:8000.
COMPOSE_PROJECT_NAME=indic-research-agent
